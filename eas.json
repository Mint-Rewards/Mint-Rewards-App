{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "developmentClient": true,
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "testflight-preview": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://mint-rewards-backend-git-dev-mint-rewards-projects.vercel.app"
      },
      "channel": "testflight-preview"
    }
  },
  "submit": {
    "production": {}
  }
}
