# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Every key below is read by app.config.js and surfaced to the app through
# config/env.ts. A missing required key throws at startup rather than silently
# defaulting.

# Which variant to build/run. "development" selects the dev bundle ID, package,
# scheme, name and icons. Anything else (or unset) means production.
# Set per build profile in eas.json; set locally only when you want the dev variant.
APP_VARIANT=development

# Backend base URL. No trailing slash (config/env.ts strips one anyway).
# Dev/preview:  https://mint-rewards-backend-git-dev-example.vercel.app
# Production:   https://mint-rewards-backend.example.com
EXPO_PUBLIC_API_URL=https://mint-rewards-backend-git-dev-example.vercel.app

# Google OAuth iOS client ID. Must match the bundle identifier of the variant
# you are building — the dev bundle needs its own client. app.config.js also
# derives the native callback URL scheme (iosUrlScheme) from this value.
GOOGLE_IOS_CLIENT_ID=000000000000-devplaceholderiosclientid.apps.googleusercontent.com

# Google OAuth Web client ID. Passed to GoogleSignin.configure() as webClientId;
# this is what the backend verifies the ID token against.
GOOGLE_WEB_CLIENT_ID=000000000000-devplaceholderwebclientid.apps.googleusercontent.com

# Optional. Android Google Sign-In authenticates via google-services.json plus
# the SHA-1 registered in Firebase, so the app never reads this. Present only so
# the value has somewhere to live if it is ever needed.
# GOOGLE_ANDROID_CLIENT_ID=000000000000-devplaceholderandroidclientid.apps.googleusercontent.com

# Google Maps SDK key for Android, injected into android.config.googleMaps.
# Restrict it by package name + SHA-1 in the Google Cloud console.
ANDROID_GOOGLE_MAPS_API_KEY=AIzaSyPlaceholderAndroidMapsKey00000000000

# Optional. PostHog product analytics. Absent means analytics calls silently
# no-op — the app still runs. Read by app.config.js, surfaced as
# extra.posthogProjectToken.
# POSTHOG_PROJECT_TOKEN=phc_placeholderprojecttoken000000000000
# POSTHOG_HOST=https://us.i.posthog.com

# NOT read from this file. Sentry's CLI reads SENTRY_AUTH_TOKEN from .env.local,
# which is separately gitignored. It is only needed if you upload source maps or
# dSYMs by hand — there is no Sentry config plugin in app.config.js, so that
# upload is not automated. See docs/HANDOFF.md §12 before creating a token: the
# previous one was committed to git history and needs rotating.
